# Only what the image needs goes into the build context; everything else stays out.
*
!gradlew
!gradle/
!settings.gradle.kts
!gradle.properties
!buildSrc/
!library/
!server/
!frontend/

# Outputs and installs of local builds.
**/build/
**/.gradle/
**/.kotlin/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/.features-gen/
frontend/.eslintcache
**/*.local
