{
  "name": "string-pipeline-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:eslint": "eslint . --max-warnings 0 --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/tests/unit",
    "test:e2e": "bddgen && playwright test --project e2e",
    "screenshots": "playwright test --project screenshots"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@tanstack/vue-query": "^5.104.5",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "sortablejs": "^1.15.7",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.89.0",
    "eslint-plugin-vue": "~10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.89.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@testing-library/vue": {
      "@testing-library/dom": "$@testing-library/dom"
    }
  },
  "allowScripts": {
    "vue-demi": false
  }
}
